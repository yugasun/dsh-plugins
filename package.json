{
  "name": "dsh-plugins",
  "private": true,
  "description": "Monorepo of independently installable DeepSeek Harness plugins, published under @yugasun.",
  "license": "MIT",
  "author": "yugasun",
  "homepage": "https://github.com/yugasun/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/yugasun/dsh-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yugasun/dsh-plugins.git"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1"
  }
}
